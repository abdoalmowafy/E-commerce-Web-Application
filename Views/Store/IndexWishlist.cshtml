@model PaginatedList<Product>
@{
    ViewData["Title"] = "Wishlist";
}

<div class="container mt-4">
    <div class="row">
        <div class="list-group">
            @foreach (var product in Model)
            {
                var MainImg = System.IO.Path.GetFileName(Directory.GetFiles($"wwwroot\\Media\\ProductMedia\\{product.Id}")[0]);

                <a asp-area="" asp-controller="Store" asp-action="FullView" asp-route-Id=@product.Id class="list-group-item list-group-item-action mb-3">
                    <div class="d-flex align-items-start">
                        <img src="~/Media/ProductMedia/@product.Id/@MainImg" class="img-thumbnail me-3" alt="@product.Name" style="width: 100px; height: 100px;">
                        <div class="flex-grow-1 ms-3">
                            <h5 class="mb-1">@product.Name</h5>
                            <small class="text-muted">@product.Category.Name</small>
                            <div>
                                @*<strong>EGP @((product.PriceCents * (100 - @product.SalePercent) / 10000.0).ToString("F2"))</strong>*@
                                <text class="d-flex"><text class="text-muted mt-1 font-italic">EGP </text><h2>@(product.PriceCents * (100 - @product.SalePercent) / 10000)</h2><text class="mt-1" style="font-style:italic">@(product.PriceCents * (100 - @product.SalePercent) % 10000 / 100) </text></text>
                                @if (product.SalePercent > 0)
                                {
                                    <del class="text-muted">(@(product.PriceCents / 100.0))</del>
                                    <span class="badge bg-success">@product.SalePercent %</span>
                                }
                            </div>
                        </div>
                    </div>
                </a>
            }
        </div>
    </div>



    <nav aria-label="Pagination">
        <ul class="pagination justify-content-center">
            @if (Model.HasPreviousPage)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="IndexWishlist" asp-route-pageIndex="@(Model.PageIndex - 1)">Previous</a>
                </li>
            }
            @for (int i = Math.Max(1, Model.PageIndex - 2); i <= Math.Min(Model.TotalPages, Model.PageIndex + 2); i++)
            {
                <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                    <a class="page-link" asp-action="IndexWishlist" asp-route-pageIndex="@i">@i</a>
                </li>
            }
            @if (Model.HasNextPage)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="IndexWishlist" asp-route-pageIndex="@(Model.PageIndex + 1)">Next</a>
                </li>
            }
        </ul>
    </nav>
</div>
