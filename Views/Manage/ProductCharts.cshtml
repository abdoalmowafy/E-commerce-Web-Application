@model dynamic
@{
    ViewData["Title"] = "Product Charts";
    var totalSalesPer = 100.0 * Model.totalSales / (Model.SKU + Model.totalSales);
    var ReturnPer = 100.0 * Model.returnCount / (Model.SKU + Model.totalSales);
    var stockPer = 100.0 * Model.SKU / (Model.SKU + Model.totalSales);
}


<div class="container mt-5">
    <div class ="text-center mb-5">
        <h2> Metrics for [@Model.Id - @Model.Name]</h2>
        Starting from
        <form method="get" asp-area="" asp-controller="Manage" asp-action="ProductCharts">
            <input type="hidden" name="id" value="@Model.Id" />
            <input type="datetime" name="starting" value="@ViewBag.starting"/>
            <button type="submit" class="btn btn-sm btn-info">Set</button>
        </form>
    </div>

    <ul>
        <li>Total Revenue = <strong>@string.Format("{0:N}", Model.revenue)</strong> EGP</li>
        <li>Views = <strong>@Model.Views</strong> view</li>
        <li>Cart Count = <strong>@Model.cartCount</strong> carts</li>
        <li>Wishlist Count = <strong>@Model.wishlistCount</strong> user wishlists</li>
    </ul>

    <div class="row m-5">
        <!-- Sales Over Time Chart -->
        <div class="col-md-12 mb-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Sales Over Time</h5>
                    <canvas id="salesOverTimeChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="row m-5">
        <!-- Sales - Returns - Stock Chart -->
        <div class="col-md-6 mb-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Sales - Returns - Stock</h5>
                    <canvas id="salesReturnsStockChart"></canvas>
                </div>
            </div>
        </div>
        <!-- Views Over Time Chart -->
        <div class="col-md-6 mb-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Views Over Time</h5>
                    <canvas id="viewsOverTimeChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="row m-5">
        <!-- Rating Chart -->
        <div class="col-md-6 mb-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Ratings</h5>
                    <canvas id="RatingsChart"></canvas>
                </div>
            </div>
        </div>
        <!-- Average Over Time Chart -->
        <div class="col-md-6 mb-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Average Rating Over Time</h5>
                    <canvas id="RatingsChart">Average Rating Over Time</canvas>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Include Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        var productData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model));

        // Total Sales Pie Chart
        var totalSalesCtx = document.getElementById('salesReturnsStockChart').getContext('2d');
        new Chart(totalSalesCtx, {
            type: 'pie',
            data: {
                labels: ['Sales', 'Returns', 'Stock'],
                datasets: [{
                    label: 'Sales - Returns - Stock',
                    data: [productData.totalSales, productData.returnCount, productData.SKU],
                    backgroundColor: ['#4caf50', '#2196f3', '#ff9800', '#f44336', '#9e9e9e', '#673ab7', '#e91e63']
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: {
                        display: true,
                        position: 'bottom'
                    }
                }
            }
        });

        // Ratings bar Chart
        var RatingsCtx = document.getElementById('RatingsChart').getContext('2d');
        new Chart(RatingsCtx, {
            type: 'bar',
            data: {
                labels: [1,2,3,4,5],
                datasets: [{
                    label: 'Rating',
                    data: productData.Ratings,
                    backgroundColor: '#2196f3'
                }]
            },
            options: {
                responsive: true,
                scales: {
                    y: {
                        beginAtZero: true
                    }
                },
                plugins: {
                    legend: {
                        display: false
                    }
                }
            }
        });

            
    </script>
}
